{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git pull)",
      "Bash(git pull *)",
      "Bash(git push)",
      "Bash(git push -u origin *)",
      "Bash(git push origin *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git merge *)",
      "Bash(git tag *)",
      "Bash(npm run check)",
      "Bash(npm test *)",
      "Bash(npm run build)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push origin --force*)",
      "Bash(git push origin -f *)",
      "Bash(git push origin +*)",
      "Bash(git reset --hard*)",
      "Bash(git branch -D *)",
      "Bash(git remote *)",
      "Read(./.env)",
      "Read(./.env.local)"
    ]
  }
}
