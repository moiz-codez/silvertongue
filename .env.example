# Copy to .env and fill in. Never commit .env.

# mock = fake replies, no API key needed (default for development and load tests)
# live = real Claude API calls
LLM_MODE=mock
ANTHROPIC_API_KEY=

# Long random string. Needed to open /admin.
ADMIN_TOKEN=change-me-to-a-long-random-string

PORT=3000
PUBLIC_URL=http://localhost:3000
DATABASE_PATH=./data/silvertongue.db

# 80% of the Evaluation tier limits shown in the Claude Console (per model)
RATE_RPM=800
RATE_ITPM=400000
RATE_OTPM=64000

COOLDOWN_MS=5000
MAX_MESSAGES_PER_PLAYER=150
MAX_MESSAGE_CHARS=300

# Floor 6 (Vorgath) open in a new game; after that it's the admin's live switch
FLOOR6_ENABLED=false

# Game auto-pauses when estimated spend reaches this (prepaid balance is ~$4.97)
BUDGET_USD=4.00

# Joins per minute from one address. The whole class may share the university's one IP: keep it generous.
JOIN_LIMIT_PER_MIN=60
